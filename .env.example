# Application Settings
APP_NAME=ByteBuddhi
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database Configuration
# POSTGRES_USER/PASSWORD/DB are read by docker-compose.yml itself (its postgres
# container and the api service's internal DATABASE_URL both derive from these),
# and DATABASE_URL below is what you get when you run the API outside Docker
# (uv run ...) against that same container via its published port 5432.
# Any PostgreSQL 16+ with pgvector works, including a managed provider such as
POSTGRES_USER=bytebuddhi
POSTGRES_PASSWORD=bytebuddhi-local
POSTGRES_DB=bytebuddhi
DATABASE_URL=postgresql+asyncpg://bytebuddhi:bytebuddhi-local@localhost:5432/bytebuddhi
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# JWT Authentication
# Development placeholder. Production startup fails if this is missing, short, or a known default.
# IMPORTANT: Change this to a secure random string of at least 32 characters in production
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-to-something-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Model gateway
# DEFAULT_MODEL_* is only the default. Clients may select any enabled, available catalog model.
DEFAULT_MODEL_PROVIDER=openai
DEFAULT_MODEL_NAME=gpt-4-turbo-preview
ENABLED_PROVIDERS=

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MODELS=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic Configuration
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MODELS=

# Operator-configured OpenAI-compatible endpoint (local/self-hosted/gateway).
# Users cannot inject this URL from API/CLI/VS Code.
OPENAI_COMPATIBLE_ENABLED=false
OPENAI_COMPATIBLE_PROVIDER_ID=openai-compatible
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODELS=

# LangSmith Configuration (Optional - for observability)
# Get your API key from: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=bytebuddhi-dev

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Rate Limiting (process-local; not distributed across workers)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
# Only honor X-Forwarded-For when the direct peer is in this list
TRUSTED_PROXY_IPS=[]

# Workspace policy
# development/test: local (user-selected project.local_path after traversal checks)
# production: managed (paths must stay under WORKSPACE_ROOT)
WORKSPACE_MODE=local
WORKSPACE_ROOT=storage/workspaces

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=[".py",".js",".ts",".java",".go",".rs",".cpp",".c",".h"]

# Web research (provider-agnostic public search + content extraction)
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_ENDPOINT=https://html.duckduckgo.com/html/
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_FETCH_TIMEOUT_SECONDS=15
WEB_FETCH_MAX_RESPONSE_BYTES=1000000
WEB_FETCH_MAX_REDIRECTS=5
WEB_FETCH_MAX_RETRIES=3
WEB_RESEARCH_MAX_PAGES=5
WEB_RESEARCH_MAX_CONCURRENT_FETCHES=4
WEB_RESEARCH_MAX_EXTRACTED_CHARS=10000
WEB_RESEARCH_MAX_TOTAL_CHARS=30000
WEB_RESEARCH_MAX_DURATION_SECONDS=30
WEB_RESEARCH_PREVIEW_CHARS=800
WEB_RENDER_ENABLED=false
WEB_RENDER_ISOLATED=false
WEB_RENDER_TIMEOUT_SECONDS=20
WEB_RENDER_MAX_PAGES=2
WEB_RENDER_MAX_BROWSER_INSTANCES=1

# Production coordination
CANCELLATION_BACKEND=local
MAX_CONCURRENT_RUNS_PER_USER=4
MAX_REQUEST_BODY_BYTES=1048576
MAX_MESSAGE_CHARS=32000
LLM_REQUEST_TIMEOUT_SECONDS=120
REDIS_REQUIRED=false
TELEMETRY_ENABLED=true
OTEL_EXPORTER=console
# CLI (local trusted principal)
# Must be an existing user UUID. Never invent or take identity from the prompt.
BYTEBUDDHI_USER_ID=
BYTEBUDDHI_PROJECT_ID=
# BYTEBUDDHI_OUTPUT=human
# BYTEBUDDHI_QUIET=0
# BYTEBUDDHI_API_URL=http://127.0.0.1:8000
# BYTEBUDDHI_CONFIG_DIR=

# OAuth identity (login only). Never commit real client secrets.
# Each provider is independently enabled. Incomplete enabled config fails startup.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/github/callback
OAUTH_STATE_TTL_SECONDS=600
OAUTH_EXCHANGE_TTL_SECONDS=120
OAUTH_HTTP_TIMEOUT_SECONDS=10
OAUTH_POST_LOGIN_REDIRECT=
OAUTH_VSCODE_REDIRECT=vscode://bytebuddhi.bytebuddhi/oauth
OAUTH_CLI_REDIRECT=
