# Application Settings
APP_NAME=ByteBuddhi
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database Configuration (Supabase PostgreSQL)
# Replace with your actual Supabase connection string
# Format: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:your-password@localhost:5432/bytebuddhi
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# JWT Authentication
# Development placeholder. Production startup fails if this is missing, short, or a known default.
# IMPORTANT: Change this to a secure random string of at least 32 characters in production
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-to-something-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic Configuration
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# LangSmith Configuration (Optional - for observability)
# Get your API key from: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=bytebuddhi-dev

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Rate Limiting (process-local; not distributed across workers)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
# Only honor X-Forwarded-For when the direct peer is in this list
TRUSTED_PROXY_IPS=[]

# Workspace policy
# development/test: local (user-selected project.local_path after traversal checks)
# production: managed (paths must stay under WORKSPACE_ROOT)
WORKSPACE_MODE=local
WORKSPACE_ROOT=storage/workspaces

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=[".py",".js",".ts",".java",".go",".rs",".cpp",".c",".h"]

# Web research (provider-agnostic public search + content extraction)
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_ENDPOINT=https://html.duckduckgo.com/html/
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_FETCH_TIMEOUT_SECONDS=15
WEB_FETCH_MAX_RESPONSE_BYTES=1000000
WEB_FETCH_MAX_REDIRECTS=5
WEB_FETCH_MAX_RETRIES=3
WEB_RESEARCH_MAX_PAGES=5
WEB_RESEARCH_MAX_CONCURRENT_FETCHES=4
WEB_RESEARCH_MAX_EXTRACTED_CHARS=10000
WEB_RESEARCH_MAX_TOTAL_CHARS=30000
WEB_RESEARCH_MAX_DURATION_SECONDS=30
WEB_RESEARCH_PREVIEW_CHARS=800
WEB_RENDER_ENABLED=false
WEB_RENDER_TIMEOUT_SECONDS=20
WEB_RENDER_MAX_PAGES=2
WEB_RENDER_MAX_BROWSER_INSTANCES=1
# CLI (local trusted principal)
# Must be an existing user UUID. Never invent or take identity from the prompt.
BYTEBUDDHI_USER_ID=
BYTEBUDDHI_PROJECT_ID=
# BYTEBUDDHI_OUTPUT=human
# BYTEBUDDHI_QUIET=0
