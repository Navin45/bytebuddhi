{
  "name": "bytebuddhi-desktop",
  "version": "0.1.4-rc.1",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate:contracts": "uv run python ../scripts/export_desktop_contracts.py",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "pack": "electron-vite build && electron-builder --config electron-builder.config.cjs",
    "pack:win": "electron-vite build && electron-builder --config electron-builder.config.cjs --win",
    "pack:mac": "electron-vite build && electron-builder --config electron-builder.config.cjs --mac",
    "pack:linux": "electron-vite build && electron-builder --config electron-builder.config.cjs --linux",
    "publish": "electron-vite build && electron-builder --config electron-builder.config.cjs --publish always"
  },
  "dependencies": {
    "electron-updater": "6.6.2",
    "highlight.js": "11.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.0.12",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
