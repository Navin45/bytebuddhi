{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["renderer/src/**/*.ts", "renderer/src/**/*.tsx", "electron/security.ts", "tests/unit/**/*.ts", "tests/unit/**/*.tsx"]
}
